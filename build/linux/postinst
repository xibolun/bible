#!/bin/sh
set -e

if [ "${1:-}" = configure ] &&
   [ -r /proc/sys/kernel/apparmor_restrict_unprivileged_userns ] &&
   [ -r /etc/apparmor.d/abi/4.0 ] &&
   [ -d /sys/kernel/security/apparmor ] &&
   command -v apparmor_parser >/dev/null 2>&1; then
    apparmor_parser -r /etc/apparmor.d/io.github.xibolun.bible
fi
