{
  "name": "bible-desktop",
  "private": true,
  "version": "0.3.1",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:serve": "vite build --emptyOutDir --outDir ../.cache/mock-dist && vite preview --outDir ../.cache/mock-dist --host 127.0.0.1 --port 5173"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "@wailsio/runtime": "3.1.0",
    "antd": "6.7.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "jsdom": "26.1.0",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  }
}
